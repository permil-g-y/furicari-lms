# ---------------------------------------------------------------------------
# フリキャリ 環境変数テンプレート
#
# このファイルは Git 管理される。実際の値は .env.local に書くこと（Git 管理外）。
# ---------------------------------------------------------------------------

# Supabase プロジェクトの URL
# Supabase Dashboard > Project Settings > Data API > Project URL
NEXT_PUBLIC_SUPABASE_URL=

# Supabase の Publishable key（sb_publishable_... で始まる公開鍵）
# Supabase Dashboard > Project Settings > API Keys > Publishable key
# ブラウザに露出してよい鍵。RLS と組み合わせて安全性を担保する。
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# 旧仕様プロジェクト向けの後方互換（Publishable key が無い場合のみ使用）
# Supabase Dashboard > Project Settings > API Keys > Legacy API keys > anon public
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# アプリの公開 URL（招待メール・パスワードリセットのリダイレクト先に使用）
# 開発: http://localhost:3000 / 本番: https://<本番ドメイン>
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# サーバー専用（絶対にクライアントへ渡さない / NEXT_PUBLIC_ を付けない）
# 将来の管理画面からの受講生招待で使用する。Phase 2 では未使用でよい。
# Supabase Dashboard > Project Settings > API Keys > Secret keys
# ---------------------------------------------------------------------------
# SUPABASE_SECRET_KEY=
