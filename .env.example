# ---------------------------------------------------------------------------
# フリキャリ 環境変数テンプレート
#
# このファイルは Git 管理される。実際の値は .env.local に書くこと（Git 管理外）。
# ---------------------------------------------------------------------------

# Supabase プロジェクトの URL
# Supabase Dashboard > Project Settings > Data API > Project URL
NEXT_PUBLIC_SUPABASE_URL=

# Supabase の Publishable key（sb_publishable_... で始まる公開鍵）
# Supabase Dashboard > Project Settings > API Keys > Publishable key
# ブラウザに露出してよい鍵。RLS と組み合わせて安全性を担保する。
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# 旧仕様プロジェクト向けの後方互換（Publishable key が無い場合のみ使用）
# Supabase Dashboard > Project Settings > API Keys > Legacy API keys > anon public
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# アプリの公開 URL（招待メール・パスワードリセットのリダイレクト先に使用）
# 開発: http://localhost:3000 / 本番: https://<本番ドメイン>
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# サーバー専用（絶対にクライアントへ渡さない / NEXT_PUBLIC_ を付けない）
# 将来の管理画面からの受講生招待で使用する。Phase 2 では未使用でよい。
# Supabase Dashboard > Project Settings > API Keys > Secret keys
# ---------------------------------------------------------------------------
# SUPABASE_SECRET_KEY=

# ---------------------------------------------------------------------------
# Cloudflare Stream（Phase 4）
#
# すべてサーバー専用。NEXT_PUBLIC_ を付けないこと。
# 未設定の間は stream_video_id が入っていてもダミープレイヤーのままになる。
#
# Require Signed URLs を有効にした動画を再生するため、
# 署名キーで RS256 の JWT をサーバー側生成する（Cloudflare 公式の推奨方式）。
# ---------------------------------------------------------------------------

# 再生URL のサブドメイン部分。
# customer-<CODE>.cloudflarestream.com の <CODE> だけを入れる。
# Cloudflare Dashboard > Stream > 動画を開く > Embed のコードに含まれている。
CLOUDFLARE_STREAM_CUSTOMER_CODE=

# 署名キーの ID（/stream/keys で発行したときに返る "id"）
CLOUDFLARE_STREAM_SIGNING_KEY_ID=

# 署名キーの秘密鍵。/stream/keys が返す "pem"（base64）をそのまま貼ってよい。
# 生の PEM を貼る場合は改行を \n に置き換えて 1 行にすること。
CLOUDFLARE_STREAM_SIGNING_KEY_PEM=

# 署名キーの発行やアップロードに使う API トークン（任意）。
# 再生だけなら不要。Phase 7 の管理画面からのアップロードで使う。
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_STREAM_API_TOKEN=
